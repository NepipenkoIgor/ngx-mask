{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "ngx-mask": {
            "root": "",
            "sourceRoot": "src",
            "projectType": "application",
            "prefix": "app",
            "schematics": {},
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "security": { "autoCsp": true },
                        "outputPath": "dist/ngx-mask",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "tsConfig": "tsconfig.app.json",
                        "assets": ["src/assets", "src/favicon.svg"],
                        "styles": [
                            "node_modules/highlight.js/styles/github.css",
                            "src/styles.scss"
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "define": {
                                "VERSION": "'<%version%>'"
                            },
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "600kb",
                                    "maximumError": "1mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "15kb",
                                    "maximumError": "15kb"
                                }
                            ],
                            "outputHashing": "all",
                            "optimization": true,
                            "sourceMap": false,
                            "extractLicenses": true,
                            "namedChunks": false
                        },
                        "development": {
                            "define": {
                                "VERSION": "'dev'"
                            },
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "namedChunks": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "ngx-mask:build:production"
                        },
                        "development": {
                            "buildTarget": "ngx-mask:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "setupFiles": ["src/test-setup.ts"]
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
                    }
                }
            }
        },
        "ngx-mask-lib": {
            "root": "projects/ngx-mask-lib",
            "sourceRoot": "projects/ngx-mask-lib/src",
            "projectType": "library",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:library",
                    "options": {
                        "tsConfig": "projects/ngx-mask-lib/tsconfig.lib.json",
                        "outputPath": "dist/ngx-mask-lib",
                        "deleteOutputPath": false
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/ngx-mask-lib/tsconfig.lib.prod.json",
                            "deleteOutputPath": true
                        },
                        "development": {
                            "tsConfig": "projects/ngx-mask-lib/tsconfig.lib.json"
                        }
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": ["**/*.js", "**/*.ts", "**/*.html", "**/*.json"]
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/ngx-mask-lib/tsconfig.spec.json",
                        "setupFiles": ["src/test-setup.ts"]
                    },
                    "configurations": {
                        "browser": {
                            "tsConfig": "projects/ngx-mask-lib/tsconfig.browser-spec.json",
                            "include": ["**/*.browser-spec.ts"],
                            "browsers": ["chromium"],
                            "headless": true,
                            "runnerConfig": "projects/ngx-mask-lib/vitest.browser.config.mts"
                        }
                    }
                }
            }
        }
    },
    "cli": {
        "warnings": {
            "typescriptMismatch": false
        },
        "analytics": "682218d2-280d-47b1-b385-b2c8c903f9a9"
    },
    "schematics": {
        "@schematics/angular:component": {
            "type": "component"
        },
        "@schematics/angular:directive": {
            "type": "directive"
        },
        "@schematics/angular:service": {
            "type": "service"
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:module": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        }
    }
}
